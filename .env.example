# Salin berkas ini menjadi .env lalu ganti nilainya. Jangan commit .env.

# Basis data lokal (docker compose). Gunakan kata sandi yang sama di tiga tempat berikut.
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-lokal
DB_PORT=5440
DATABASE_URL=postgresql://payme:ganti-dengan-kata-sandi-lokal@localhost:5440/payme?schema=public
TEST_DATABASE_URL=postgresql://payme:ganti-dengan-kata-sandi-lokal@localhost:5440/payme_test?schema=public

# Kunci acak minimal 32 karakter, dipakai untuk menyamarkan IP dan perangkat pada pembatasan percobaan.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=ganti-dengan-kunci-acak-minimal-32-karakter

# Isi true hanya bila aplikasi berjalan di belakang proxy tepercaya (Vercel, Nginx, Cloudflare)
# yang menimpa header X-Forwarded-For. Bila false, IP klien tidak dipercaya dari header.
TRUST_PROXY=false
